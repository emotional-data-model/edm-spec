{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://deepadata.com/schemas/edm/v0.9.0-draft/edm.extended.schema.json",
  "title": "EDM v0.9.0 Extended Profile (DRAFT, discovery)",
  "description": "DRAFT composite for the v0.9 layout proposed in docs/discovery/ontology-crosswalk-2026-10/v0.9-proposal.md. 28 affective fields over 5 affective domains, derived by R17 (2026-10-18) as every field whose comparability class is comparable + interpretive + null-driven; the trait block is not included (opt-in via partner manifest); extensions allowed; text of coded fields is a recommended vocabulary (string), codings on the EDM vocabulary are enumerated. Not normative; not under VERSIONING_POLICY until adopted.",
  "x_affective_field_count": 28,
  "x_affective_fields": [
    "narrative.subject",
    "narrative.trigger",
    "narrative.harm",
    "narrative.drive",
    "narrative.integration",
    "narrative.summary",
    "narrative.meaning",
    "narrative.identity_link",
    "narrative.turning_point",
    "narrative.self_position",
    "emotion.primary",
    "emotion.valence",
    "emotion.intensity",
    "emotion.bodily_sensation",
    "emotion.temporal_profile",
    "emotion.appraisal.attribution",
    "context.event_category",
    "context.relationship",
    "context.scope",
    "salience.memory_type",
    "salience.tether",
    "salience.linkage_strength",
    "salience.function",
    "motivation.action_tendency",
    "motivation.need",
    "motivation.temporal_focus",
    "motivation.risk_posture",
    "motivation.coping"
  ],
  "x_profile_rule": "R17 (2026-10-18): profile membership is derived from the comparability class, not chosen. Essential = every affective field classed \"comparable\" (run-1 pass on populated answers, or run-2 pass, and - for the 19 comparable-tier fields tested across vendors in run 3 - holding the market rule under R18 reading (b), R19-R28); Extended = Essential + \"interpretive\" + \"null-driven\"; Full = all 47; partner profiles select freely from their base. Field class = class of the lead unit (LEAD_UNIT); sub-members ride with their field. Computed in scripts/v09_layout.py (COMPARABILITY, PROFILES_09); nothing hand-listed.",
  "x_comparability_classes": [
    "comparable",
    "interpretive",
    "null-driven"
  ],
  "type": "object",
  "required": [
    "meta",
    "narrative",
    "emotion",
    "context",
    "salience",
    "motivation",
    "governance",
    "telemetry"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "description": "Identity, provenance, and consent metadata. Extended profile includes optional source tracking.",
      "type": "object",
      "required": [
        "version",
        "profile",
        "created_at",
        "visibility",
        "pii_tier",
        "consent_basis"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Unique identifier for the EDM artifact.",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "version": {
          "type": "string",
          "description": "EDM schema version.",
          "pattern": "^0\\.9\\.[0-9]+(-draft)?$"
        },
        "profile": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "essential",
                "extended",
                "full"
              ],
              "description": "Canonical extraction profile"
            },
            {
              "type": "string",
              "pattern": "^partner:.+$",
              "description": "Partner profile ID with namespace prefix per EDM v0.8.0 Section 3.7.2 and ADR-0017 — e.g. partner:com.deepadata.journaling.v1"
            }
          ]
        },
        "created_at": {
          "type": "string",
          "description": "Artifact extraction timestamp.",
          "format": "date-time"
        },
        "updated_at": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional post-extraction update timestamp.",
          "format": "date-time"
        },
        "locale": {
          "type": [
            "string",
            "null"
          ],
          "description": "Linguistic and cultural context.",
          "pattern": "^[a-z]{2}(-[a-z]{2})?$"
        },
        "owner_user_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Artifact owner identifier."
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Parent artifact link.",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "visibility": {
          "type": "string",
          "enum": [
            "private",
            "shared",
            "public"
          ],
          "description": "Artifact visibility scope."
        },
        "pii_tier": {
          "type": "string",
          "enum": [
            "none",
            "low",
            "moderate",
            "high",
            "extreme"
          ],
          "description": "PII classification level."
        },
        "source_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "text",
            "audio",
            "image",
            "video",
            "mixed",
            null
          ],
          "description": "Source medium."
        },
        "source_context": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional input scenario description."
        },
        "consent_basis": {
          "type": "string",
          "enum": [
            "consent",
            "contract",
            "legitimate_interest",
            "none"
          ],
          "description": "Legal basis for processing."
        },
        "consent_scope": {
          "type": [
            "string",
            "null"
          ],
          "description": "Consent scope description."
        },
        "tags": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "User-defined labels."
        }
      }
    },
    "narrative": {
      "allOf": [
        {
          "$ref": "https://deepadata.com/schemas/edm/v0.9.0-draft/fragments/narrative.json"
        },
        {
          "type": "object",
          "propertyNames": {
            "enum": [
              "subject",
              "trigger",
              "harm",
              "drive",
              "integration",
              "summary",
              "meaning",
              "identity_link",
              "turning_point",
              "self_position"
            ]
          },
          "required": [
            "harm",
            "summary",
            "meaning",
            "turning_point",
            "self_position"
          ]
        }
      ],
      "x_fields": [
        "narrative.subject",
        "narrative.trigger",
        "narrative.harm",
        "narrative.drive",
        "narrative.integration",
        "narrative.summary",
        "narrative.meaning",
        "narrative.identity_link",
        "narrative.turning_point",
        "narrative.self_position"
      ]
    },
    "emotion": {
      "allOf": [
        {
          "$ref": "https://deepadata.com/schemas/edm/v0.9.0-draft/fragments/emotion.json"
        },
        {
          "type": "object",
          "propertyNames": {
            "enum": [
              "primary",
              "valence",
              "intensity",
              "bodily_sensation",
              "temporal_profile",
              "appraisal"
            ]
          },
          "required": [
            "primary",
            "valence",
            "intensity",
            "bodily_sensation",
            "appraisal"
          ],
          "properties": {
            "appraisal": {
              "type": [
                "object",
                "null"
              ],
              "propertyNames": {
                "enum": [
                  "attribution"
                ]
              },
              "required": [
                "attribution"
              ]
            }
          }
        }
      ],
      "x_fields": [
        "emotion.primary",
        "emotion.valence",
        "emotion.intensity",
        "emotion.bodily_sensation",
        "emotion.temporal_profile",
        "emotion.appraisal.attribution"
      ]
    },
    "context": {
      "allOf": [
        {
          "$ref": "https://deepadata.com/schemas/edm/v0.9.0-draft/fragments/context.json"
        },
        {
          "type": "object",
          "propertyNames": {
            "enum": [
              "event_category",
              "relationship",
              "scope"
            ]
          },
          "required": [
            "event_category",
            "relationship",
            "scope"
          ]
        }
      ],
      "x_fields": [
        "context.event_category",
        "context.relationship",
        "context.scope"
      ]
    },
    "salience": {
      "allOf": [
        {
          "$ref": "https://deepadata.com/schemas/edm/v0.9.0-draft/fragments/salience.json"
        },
        {
          "type": "object",
          "propertyNames": {
            "enum": [
              "memory_type",
              "tether",
              "linkage_strength",
              "function"
            ]
          },
          "required": [
            "function"
          ]
        }
      ],
      "x_fields": [
        "salience.memory_type",
        "salience.tether",
        "salience.linkage_strength",
        "salience.function"
      ]
    },
    "motivation": {
      "allOf": [
        {
          "$ref": "https://deepadata.com/schemas/edm/v0.9.0-draft/fragments/motivation.json"
        },
        {
          "type": "object",
          "propertyNames": {
            "enum": [
              "action_tendency",
              "need",
              "temporal_focus",
              "risk_posture",
              "coping"
            ]
          },
          "required": [
            "action_tendency",
            "need",
            "temporal_focus",
            "coping"
          ]
        }
      ],
      "x_fields": [
        "motivation.action_tendency",
        "motivation.need",
        "motivation.temporal_focus",
        "motivation.risk_posture",
        "motivation.coping"
      ]
    },
    "governance": {
      "$ref": "https://deepadata.com/schemas/edm/v0.8.0/fragments/governance.json"
    },
    "telemetry": {
      "$ref": "https://deepadata.com/schemas/edm/v0.9.0-draft/fragments/telemetry.json"
    },
    "extensions": {
      "$ref": "https://deepadata.com/schemas/edm/v0.8.0/fragments/extensions.json",
      "x_note": "Allowed (optional) in every profile by ruling 2026-10-17, so that migration can preserve cut and out-of-profile text. The v0.8 composites do not list extensions (README known limitation)."
    }
  }
}
