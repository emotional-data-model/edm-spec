        "extended",
        "full"
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "event_category": {
      "description": "Coded companion to context.event: the content category of the event as the subject describes it.",
      "x_constraints": "Singer & Blagov / Thorne & McLean categories: relationships, life_threatening_events, recreation_exploration, achievement_mastery, guilt_shame, drug_alcohol_tobacco_use, not_classifiable (labels knowledge-reconstructed; REPORT.md section 9)",
      "x_profiles": [
        "full"
      ],
      "allOf": [
        {
          "$ref": "https://deepadata.com/schemas/edm/v0.9.0-draft/fragments/common.json#/definitions/coded"
        },
        {
          "properties": {
            "codings": {
              "items": {
                "if": {
                  "properties": {
                    "system": {
                      "const": "https://emotionaldatamodel.org/vocab/event_category/v1"
                    }
                  },
                  "required": [
                    "system"
                  ]
                },
                "then": {
                  "properties": {
                    "code": {
                      "enum": [
                        "achievement_mastery",
                        "drug_alcohol_tobacco_use",
                        "guilt_shame",
                        "life_threatening_events",
                        "not_classifiable",
                        "recreation_exploration",
                        "relationships"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "x_edm_vocabulary": "https://emotionaldatamodel.org/vocab/event_category/v1",
