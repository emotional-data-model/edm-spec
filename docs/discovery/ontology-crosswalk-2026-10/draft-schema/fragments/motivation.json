      "x_constraints": "Canonical: explore, approach, avoid, repair, persevere, share, confront, protect, process (Frijda action tendencies applied as codes; value words unchanged)",
      "x_profiles": [
        "full"
      ],
      "allOf": [
        {
          "$ref": "https://deepadata.com/schemas/edm/v0.9.0-draft/fragments/common.json#/definitions/coded"
        },
        {
          "properties": {
            "codings": {
              "items": {
                "if": {
                  "properties": {
                    "system": {
                      "const": "https://emotionaldatamodel.org/vocab/action_tendency/v1"
                    }
                  },
                  "required": [
                    "system"
                  ]
                },
                "then": {
                  "properties": {
                    "code": {
                      "enum": [
                        "approach",
                        "avoid",
                        "confront",
                        "explore",
                        "persevere",
                        "process",
                        "protect",
                        "repair",
                        "share"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "x_edm_vocabulary": "https://emotionaldatamodel.org/vocab/action_tendency/v1",
      "x_recommended_values": [
