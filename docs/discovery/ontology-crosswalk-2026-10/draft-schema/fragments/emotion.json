        "anxiety",
        "disappointment",
        "fear",
        "frustration",
        "gratitude",
        "hope",
        "joy",
        "longing",
        "peace",
        "pride",
        "relief",
        "reverence",
        "sadness",
        "shame",
        "tenderness",
        "wonder"
      ]
