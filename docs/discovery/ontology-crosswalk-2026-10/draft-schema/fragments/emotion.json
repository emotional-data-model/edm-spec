      "description": "The dominant emotional quality expressed in the experience",
      "x_constraints": "Canonical values: joy, sadness, fear, anger, wonder, peace, tenderness, reverence, pride, anxiety, gratitude, longing, hope, shame, disappointment, relief, frustration. Free text accepted.",
      "x_profiles": [
        "essential",
        "extended",
        "full"
      ],
      "allOf": [
        {
          "$ref": "https://deepadata.com/schemas/edm/v0.9.0-draft/fragments/common.json#/definitions/coded"
        },
        {
          "properties": {
            "codings": {
              "items": {
                "if": {
                  "properties": {
                    "system": {
                      "const": "https://emotionaldatamodel.org/vocab/emotion/v1"
                    }
                  },
                  "required": [
                    "system"
                  ]
                },
                "then": {
                  "properties": {
                    "code": {
                      "enum": [
                        "anger",
                        "anxiety",
                        "disappointment",
                        "fear",
                        "frustration",
                        "gratitude",
                        "hope",
                        "joy",
                        "longing",
                        "peace",
                        "pride",
                        "relief",
                        "reverence",
                        "sadness",
                        "shame",
                        "tenderness",
                        "wonder"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
