{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://deepadata.com/schemas/edm/v0.9.0-draft/fragments/emotion.json",
  "title": "EDM EMOTION Domain (v0.9 DRAFT)",
  "description": "The affect itself: category, valence, arousal, intensity, meta-emotion, bodily sensation, temporal profile and appraisal (v0.8.3 constellation emotion fields + gravity.valence / emotional_weight + impulse urgency / agency_level).",
  "type": "object",
  "properties": {
