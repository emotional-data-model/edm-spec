      "x_recommended_values": [
        "disposition",
        "emotion",
        "feeling",
        "mood"
      ]
    },
    "valence": {
      "description": "The qualitative direction of the emotional experience",
      "x_constraints": "text positive / negative / mixed; value in [-1, 1] on EmotionML fsre-dimensions#valence, populated only by an extraction that produces it (never derived from text)",
      "x_profiles": [
        "essential",
        "extended",
        "full"
      ],
      "allOf": [
        {
          "$ref": "https://deepadata.com/schemas/edm/v0.9.0-draft/fragments/common.json#/definitions/dimension"
