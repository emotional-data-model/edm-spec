    "intensity": {
      "description": "The felt intensity of the emotional experience",
      "x_constraints": "value in [0, 1] (v0.8.3 emotional_weight carried as-is); text is an optional ordinal label",
      "x_profiles": [
        "essential",
        "extended",
        "full"
      ],
      "allOf": [
        {
          "$ref": "https://deepadata.com/schemas/edm/v0.9.0-draft/fragments/common.json#/definitions/dimension"
        },
        {
          "properties": {
            "value": {
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      ]
