{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://deepadata.com/schemas/edm/v0.9.0-draft/edm.full.schema.json",
  "title": "EDM v0.9.0 Full Profile (DRAFT, discovery)",
  "description": "DRAFT composite for the v0.9 layout proposed in docs/discovery/ontology-crosswalk-2026-10/v0.9-proposal.md. 47 affective fields over 5 affective domains; the trait block is not included (opt-in via partner manifest); extensions allowed; text of coded fields is a recommended vocabulary (string), codings on the EDM vocabulary are enumerated. Not normative; not under VERSIONING_POLICY until adopted.",
  "x_affective_field_count": 47,
  "x_affective_fields": [
    "narrative.subject",
    "narrative.trigger",
    "narrative.harm",
    "narrative.drive",
    "narrative.integration",
