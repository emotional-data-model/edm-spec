    "emotion.valence",
    "emotion.arousal",
    "emotion.intensity",
    "emotion.meta",
    "emotion.bodily_sensation",
    "emotion.temporal_profile",
    "emotion.appraisal.urgency",
    "emotion.appraisal.control",
    "emotion.appraisal.attribution",
    "context.event",
    "context.event_category",
    "context.place",
    "context.people",
    "context.relationship",
    "context.relationship_model",
    "context.life_stage",
    "context.scope",
